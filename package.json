{
  "name": "xmachinevue",
  "author": {
    "url": "https://github.com/KamilBartczak03",
    "name": "Kamil Bartczak"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkamkl9/XMachineVue.git"
  },
  "bugs": {
    "url": "https://github.com/bkamkl9/XMachineVue/issues"
  },
  "homepage": "https://bkamkl9.github.io/XMachineVue/",
  "keywords": ["vue 3", "state machine", "state management"],
  "description": "Typed workflow state machines for Vue applications.",
  "private": false,
  "version": "4.0.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev src/docs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev src/docs",
    "docs:build": "vitepress build src/docs",
    "docs:preview": "vitepress preview src/docs",
    "lint": "biome check .",
    "prepack": "pnpm build",
    "jsr:check": "pnpm dlx jsr publish --dry-run",
    "jsr:publish": "pnpm dlx jsr publish"
  },
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^18.19.63",
    "jsdom": "^22.1.0",
    "lefthook": "^1.8.2",
    "prettier": "^3.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "vite": "^4.5.5",
    "vitepress": "1.0.0-rc.31",
    "vitest": "^0.34.6",
    "vue": "^3.5.12"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0"
}
